# Kopieren nach ".env" fuer lokale Tests (npm run dry-run benoetigt diese Datei nicht,
# npm start / npm run start-live schon, sobald wirklich gemailt werden soll).

# SMTP-Zugangsdaten des Absender-Postfachs (z.B. Gmail mit App-Passwort)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deinabsender@gmail.com
SMTP_PASS=app-passwort

# Absenderadresse (muss bei Amazon als "genehmigter" Absender hinterlegt sein)
MAIL_FROM=deinabsender@gmail.com

# Send-to-Kindle Adresse(n), kommagetrennt fuer mehrere Geraete
KINDLE_EMAIL=deinname_XXXXX@kindle.com

# Optional: Verhalten anpassen
# TIMEZONE=Europe/Athens
# MAX_ITEMS_PER_FEED=8
# FETCH_FULL_ARTICLES=true
# ARTICLE_TIMEOUT_MS=10000
# ARTICLE_CONCURRENCY=4
# FEED_TIMEOUT_MS=15000
# DRY_RUN=false
